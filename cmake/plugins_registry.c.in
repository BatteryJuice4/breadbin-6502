// Generated by CMake from BB_PLUGIN_SOURCES: registers the built-in plugins.
#include "mods/plugin.h"

#include <stdio.h>

@BB_PLUGIN_DECLS@
void bb_register_plugins(void);
void bb_register_plugins(void) {
    static const bb_plugin_t* const plugins[] = { @BB_PLUGIN_LIST@NULL };
    for (int i = 0; plugins[i]; i++) {
        if (!plugin_register(plugins[i])) {
            fprintf(stderr, "breadbin-6502: plugin \"%s\" wasn't registered (check its name and api)\n",
                    plugins[i]->name ? plugins[i]->name : "?");
        }
    }
}
